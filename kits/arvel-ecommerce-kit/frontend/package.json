{
  "name": "arvel-ecommerce-kit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest --run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.100.14",
    "@vueuse/core": "^14.3.0",
    "pathe": "^2.0.3",
    "pinia": "^3.0.4",
    "vue": "3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/shared": "^3.5.35",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "orval": "7.13.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.2"
  }
}
