# Local development settings for the e-commerce kit.
# Copy to .env before running docker compose.

APP_NAME=Arvel E-Commerce Kit
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_KEY=local-development-key-32-bytes-rotate

# Service ports. Override if they clash.
FRONTEND_PORT=8000
BACKEND_PORT=8001

# Default admin credentials. Change before sharing the instance with anyone.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminPwd!1

# Human-readable single-line logs to stdout (no OTLP collector locally).
# debug surfaces the per-route "route.registered" lines on startup.
LOG_FORMAT=console
LOG_LEVEL=debug
# Off so the framework emits its own richer access log (method, path, status,
# duration) instead of uvicorn's duplicate line.
LOG_UVICORN_ACCESS=false

DB_CONNECTION=postgresql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=arvel_ecommerce
DB_USERNAME=arvel
DB_PASSWORD=arvel_local_password
DB_ECHO=false

CACHE_CONNECTION=redis
CACHE_URL=redis://:arvel_local_redis_password@redis:6379/0
CACHE_PREFIX=arvel-ecommerce:cache:
REDIS_PASSWORD=arvel_local_redis_password
REDIS_PORT=6379

# Default to s3 so the bundled MinIO + Caddy edge works out of the box —
# the SPA's "primary entry" Caddy edge (:8002) serves /media/* by proxying
# to MinIO, and the seeder writes uploads into the MinIO bucket. Flip to
# `local` for a zero-deps fallback that skips MinIO; in local mode you MUST
# load the SPA from :8001 (not :8002) because the backend's serve=true route
# owns /media/* there, NOT Caddy.
STORAGE_DEFAULT=s3

# --- S3 / MinIO (default driver) ---
# Compose ships minio + createbuckets + caddy pre-wired:
#   minio:9000              — in-network S3 endpoint (backend writes here)
#   caddy:80 (host :8002)   — browser-facing /media/* proxy to MinIO
#   createbuckets           — one-shot: creates the bucket + sets anonymous-download
# Credentials below are development-only — rotate before exposing the instance.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_PUBLIC_URL=http://localhost:8002/media
STORAGE_S3_BUCKET=arvel-ecommerce-kit
STORAGE_S3_KEY=minioadmin
STORAGE_S3_SECRET=minioadmin
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ADDRESSING_STYLE=path

# --- Local disk (opt-in fallback, used when STORAGE_DEFAULT=local) ---
# The framework's serve=true route serves /media/* from the backend at :8001.
# Caddy's /media/* route is wired to MinIO and stays dormant in local mode —
# don't load the SPA from Caddy (:8002) in local mode or images will 404.
# STORAGE_LOCAL_ROOT is relative to the backend CWD (consistent inside Docker,
# standalone runs, and tests). STORAGE_LOCAL_URL is a relative URL; the browser
# resolves it against the current origin. Set absolute behind a CDN.
STORAGE_LOCAL_ROOT=storage/app
STORAGE_LOCAL_URL=/media
STORAGE_LOCAL_SERVE=true

# Compose port overrides for the new services.
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001
CADDY_PORT=8002

JWT_ISSUER=arvel-ecommerce-kit
JWT_AUDIENCE=arvel-ecommerce-kit
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
REFRESH_COOKIE_SECURE=false
