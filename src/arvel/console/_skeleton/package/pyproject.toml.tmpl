[project]
name = "arvel-{{name}}"
dynamic = [
  "version",
] # single-sourced from {{mod}}.__version__ (release-please managed)
description = "An arvel ecosystem package."
readme = "README.md"
requires-python = ">=3.14"
license = "MIT"
authors = [{ name = "Your Name", email = "you@example.com" }]
keywords = ["arvel", "{{name}}"]
classifiers = [
  "Programming Language :: Python :: 3.14",
  "Framework :: AsyncIO",
  "Typing :: Typed",
]
dependencies = ["arvel"]

[project.urls]
# Fill these in for the PyPI sidebar, then uncomment:
# Homepage = "https://github.com/you/arvel-{{name}}"
# Issues = "https://github.com/you/arvel-{{name}}/issues"

# Each heavy driver engine gets an extra — apps install only what they use, and
# MissingExtraError points at the fix: uv add 'arvel-{{name}}[<extra>]'.
[project.optional-dependencies]
# redis = ["redis"]

# Installing this package auto-registers the provider — the host app edits nothing.
[project.entry-points."arvel.providers"]
{{name}} = "{{mod}}.provider:{{cls}}ServiceProvider"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.version]
path = "src/{{mod}}/__init__.py" # reads __version__ — one source of truth

[tool.hatch.build.targets.wheel]
packages = ["src/{{mod}}"]

[dependency-groups]
dev = [
  "pytest",
  "pytest-asyncio",
  "ruff",
  "mypy",
  "pyright",
  "import-linter",
  "bandit",
  "pip-audit",
  "pre-commit",
]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.mypy]
strict = true
mypy_path = "src"

[tool.importlinter]
root_package = "{{mod}}"
include_external_packages = true

# The light-import discipline, enforced in CI (same rule arvel core lives by):
# heavy engines never appear on the module import path — drivers lazy-import
# them inside the method that uses them. List each engine you add here.
[[tool.importlinter.contracts]]
name = "heavy engines stay out of the import path"
type = "forbidden"
source_modules = ["{{mod}}"]
forbidden_modules = ["httpx"]
