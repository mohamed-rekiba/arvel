{
  "name": "arvel-ecommerce-demo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest --run",
    "typecheck": "vue-tsc --noEmit",
    "api:generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.100.14",
    "@vueuse/core": "^13.2.0",
    "pathe": "^2.0.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.34",
    "vue-i18n": "^10.0.7",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/shared": "^3.5.34",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^10.1.0",
    "happy-dom": "^17.4.7",
    "orval": "^7.13.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "vue-tsc": "^2.2.10"
  }
}
