[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ project_name_pascal }} — an Arvel application."
requires-python = ">={{ python_version }}"
dependencies = ["arvel[sqlite]"]

[dependency-groups]
dev = [
    "arvel[shell]",
    "httpx>=0.28.1",
    "pytest>=9.0.3",
    "pytest-asyncio>=1.3.0",
]

[tool.uv.sources]
arvel = { path = "../packages/arvel" }

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app", "bootstrap", "config", "routes", "public"]
